---
import Layout from '../../layouts/Layout.astro';

interface Artist {
  ID: number;
  Name: string;
  Slug: string;
}

const res = await fetch("http://localhost:8080/artists");
const artists: Artist[] = await res.json();
---

<Layout title="Artists | Illa-Music">
  <main class="flex-col items-center text-center justify-center pages">
    <h1 class="text-xl font-bold">Artists</h1>
    <ul class="tracking-widest py-4">
      {artists.map((artist) => (
        <li class="py-2 font-medium hover:underline decoration-1">
          <a href={`/artists/${artist.Slug}`}>{artist.Name}</a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
