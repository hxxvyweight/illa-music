---
import Layout from '../layouts/Layout.astro';
const res = await fetch("http://localhost:8080/artists");
const artists = await res.json();
---

<div class="content-pages">
      <h1>Local Artists</h1>
      <ul>
        {artists.map((artist) => (
          <li>
            <strong>{artist.name}</strong>
          </li>
        ))}
      </ul>
    </div>
