---
import Layout from '../../layouts/Layout.astro';

interface Label {
  ID: number;
  Name: string;
  Location: string;
  Slug: string;
}

const res = await fetch("http://localhost:8080/labels");
const labels: Label[] = await res.json();
---

<Layout title="Labels | Illa-Music">
  <main class="flex-col items-center text-center justify-center pages">
    <h1 class="text-xl font-bold">Labels</h1>
    <ul class="tracking-widest py-4">
      {labels.map((label) => (
        <li class="py-2 decoration-1">
		<a class="hover:underline"href={`/artists/${label.Slug}`}>{label.Name}</a>
		<p>Location: {label.Location}</p>
        </li>
      ))}
    </ul>
  </main>
</Layout>
