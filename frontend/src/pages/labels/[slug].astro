---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const labels = await getCollection('labels');

  return labels.map((label) => ({
    params: { slug: label.data.slug || label.id },
    props: { label },
  }));
}

const { label } = Astro.props;
const { Content } = await render(genre);
---

<Layout title={`${label.data.name} | Illawarra Collections`}>
  <main class="pages">
    <h1>{label.data.name}</h1>

    {label.data.category && <p><strong>Category:</strong> {label.data.category}</p>}
    {label.data.origin && <p><strong>Origin:</strong> {label.data.origin}</p>}

    <article class="content">
      <Content />
    </article>
  </main>
</Layout>
